{
  "name": "angular-grid-layout",
  "version": "1.3.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:lib && npm run build:client",
    "build:lib": "ng build drag-drop-layout --configuration production",
    "build:lib:locally": "ng build drag-drop-layout --configuration production && cd dist/drag-drop-layout && npm pack --pack-destination ../",
    "build:client": "ng build client --configuration production",
    "build:client:github-pages": "ng build client --configuration github-pages",
    "watch": "ng build --watch --configuration development",
    "watch:lib": "ng build drag-drop-layout --watch --configuration development",
    "serve:client": "ng serve client --port 80 --host 0.0.0.0",
    "test": "npm run test:lib && npm run test:client",
    "test:lib": "ng test drag-drop-layout --watch=false",
    "test:client": "ng test client --watch=false",
    "verify": "npm run build && npm test && npm run test:demo && npm run audit:security",
    "release": "standard-version",
    "audit:security": "npm audit --audit-level=high",
    "test:compatibility": "node scripts/compatibility.mjs",
    "verify:release": "npm run verify && npm run test:compatibility",
    "test:demo": "playwright test --config tests/demo/playwright.config.mjs"
  },
  "dependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/router": "^20.3.34",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@types/node": "^24.0.0",
    "ng-packagr": "^20.3.2",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3",
    "@playwright/test": "^1.58.0",
    "@angular/build": "^20.3.40",
    "vitest": "3.2.7",
    "@vitest/browser": "3.2.7",
    "less": "^4.2.0"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.32.1"
    },
    "@angular/build": {
      "vite": "7.3.7"
    },
    "vitest": {
      "tinypool": "2.1.2"
    }
  }
}
