{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "drag-drop-layout": {
      "projectType": "library",
      "root": "projects/drag-drop-layout",
      "sourceRoot": "projects/drag-drop-layout/src",
      "prefix": "ddl",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/drag-drop-layout/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/drag-drop-layout/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/drag-drop-layout/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/drag-drop-layout/tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "drag-drop-layout:test-build",
            "browsers": [
              "ChromiumHeadless"
            ],
            "providersFile": "tests/unit/providers.ts",
            "setupFiles": [
              "tests/unit/setup.ts"
            ]
          }
        },
        "test-build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/test-host",
            "tsConfig": "projects/drag-drop-layout/tsconfig.spec.json",
            "polyfills": [],
            "styles": [],
            "index": false
          }
        }
      }
    },
    "client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "projects/client",
      "sourceRoot": "projects/client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/client",
              "browser": ""
            },
            "index": "projects/client/src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/client/tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/client/public"
              }
            ],
            "styles": [
              "projects/client/src/styles.less"
            ],
            "scripts": [],
            "browser": "projects/client/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "github-pages": {
              "baseHref": "/angular-drag-drop-layout/",
              "deployUrl": "/angular-drag-drop-layout/"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "testing": {
              "polyfills": []
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "client:build:production"
            },
            "development": {
              "buildTarget": "client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/client/tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "client:build:development,testing",
            "browsers": [
              "ChromiumHeadless"
            ],
            "providersFile": "tests/unit/providers.ts",
            "setupFiles": [
              "tests/unit/setup.ts"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
